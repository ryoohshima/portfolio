---
import { Icon } from "astro-icon/components";
import { fade, slide } from "astro:transitions";

interface ContactLink {
  name: string;
  icon: string;
  href: string;
  label: string;
  color: string;
}

const contacts: ContactLink[] = [
  {
    name: "GitHub",
    icon: "simple-icons:github",
    href: "https://github.com/Ryo-Ohshima",
    label: "GitHubプロフィール",
    color: "#FFFFFF",
  },
  {
    name: "X",
    icon: "simple-icons:x",
    href: "https://x.com/Ryo_Ohshima_",
    label: "Xアカウント",
    color: "#FFFFFF",
  },
  {
    name: "LinkedIn",
    icon: "simple-icons:linkedin",
    href: "https://www.linkedin.com/in/%E9%BE%8D-%E5%A4%A7%E5%B3%B6-178625351/",
    label: "LinkedInプロフィール",
    color: "#0A66C2",
  },
  {
    name: "Email",
    icon: "simple-icons:gmail",
    href: "mailto:ryo.ohshima.official@gmail.com",
    label: "メールを送る",
    color: "#EA4335",
  },
];
---

<section
  id="contact"
  aria-labelledby="contact-title"
  class="py-20"
  transition:animate={fade({ duration: "0.3s" })}
>
  <div class="max-w-6xl mx-auto px-4">
    <h2
      id="contact-title"
      class="text-3xl font-bold mb-12 text-center"
      transition:animate={slide({ duration: "0.4s" })}
    >
      CONTACT
      <span class="block w-12 h-1 bg-amber-400 mx-auto mt-4 rounded-full"></span>
    </h2>
    <ul class="flex justify-center gap-8">
      {
        contacts.map((contact, index) => (
          <li
            style={`--brand-color: ${contact.color}`}
            transition:animate={fade({ duration: `${0.3 + index * 0.1}s` })}
          >
            <a
              href={contact.href}
              target={contact.href.startsWith("mailto:") ? undefined : "_blank"}
              rel={
                contact.href.startsWith("mailto:")
                  ? undefined
                  : "noopener noreferrer"
              }
              aria-label={contact.label}
              class="group flex flex-col items-center gap-2 p-4 rounded-2xl hover:bg-slate-900 transition-[background-color,transform] duration-300 hover:scale-105"
            >
              <Icon name={contact.icon} class="w-10 h-10 transition-colors duration-300 group-hover:[color:var(--brand-color)]" />
              <span class="text-sm">{contact.name}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

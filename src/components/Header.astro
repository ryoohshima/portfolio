---
import profileSvg from "@/assets/images/profile_white.svg?raw";

const profile = {
  name: "Ryo Ohshima",
};

const navItems = [
  { label: "PROJECTS", href: "#projects" },
  { label: "SKILLS", href: "#skills" },
  { label: "CONTACT", href: "#contact" },
];
---

<header
  class="sticky top-0 z-header backdrop-blur-sm bg-gradient-to-r from-slate-950/80 to-slate-800/80"
  transition:persist
  transition:animate="none"
>
  <div class="max-w-6xl mx-auto p-4 flex items-center justify-between">
    <a
      href="/"
      class="w-16 h-16 text-slate-300 [&_svg]:w-full [&_svg]:h-full [&_path]:fill-current"
      aria-label={`${profile.name}のプロフィール`}
    >
      <Fragment set:html={profileSvg} />
    </a>
    <nav aria-label="メインナビゲーション">
      <ul class="flex gap-8">
        {
          navItems.map((item) => (
            <li>
              <a href={item.href} class="text-sm font-medium hover:text-violet-400 transition-colors">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

---
import { Image } from "astro:assets";
import profileImage from "@/assets/images/profile.png";

const profile = {
  name: "Ryo Ohshima",
};

const navItems = [
  { label: "PROJECTS", href: "#projects" },
  { label: "SKILLS", href: "#skills" },
  { label: "CONTACT", href: "#contact" },
];
---

<header
  class="sticky top-0 z-header backdrop-blur-sm bg-gradient-to-r from-slate-950/80 to-slate-800/80"
  transition:persist
  transition:animate="none"
>
  <div class="max-w-6xl mx-auto p-4 flex items-center justify-between">
    <a href="/" class="text-xl font-bold">
      <Image
        src={profileImage}
        alt={`${profile.name}のプロフィール画像`}
        width={280}
        height={280}
        class="w-16 h-16 rounded-full object-cover"
      /></a
    >
    <nav aria-label="メインナビゲーション">
      <ul class="flex gap-8">
        {
          navItems.map((item) => (
            <li>
              <a href={item.href} class="text-sm font-medium ">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

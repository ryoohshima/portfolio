---
import { fade, slide } from "astro:transitions";
import profileSvg from "@/assets/images/profile_white.svg?raw";

const profile = {
  name: "Ryo Ohshima",
  title: "FE ENGINEER",
};
---

<section
  aria-label="ヒーローセクション"
  class="hero-section min-h-screen flex items-center relative overflow-hidden"
  transition:animate={fade({ duration: "0.3s" })}
>
  <!-- パーティクル背景 -->
  <div class="particles" aria-hidden="true">
    {Array.from({ length: 20 }).map((_, i) => (
      <span class="particle" style={`--i: ${i}`} />
    ))}
  </div>

  <div class="w-full max-w-6xl mx-auto p-4 flex items-center justify-between relative z-10">
    <div class="flex-1 text-center md:text-left">
      <h1
        class="text-4xl md:text-5xl lg:text-6xl font-bold mb-4"
        transition:animate={slide({ duration: "0.5s" })}
      >
        {profile.name}
      </h1>
      <p
        class="typing-text text-lg md:text-xl tracking-widest mb-8"
        transition:animate={slide({ duration: "0.4s" })}
      >
        <span class="typing">{profile.title}</span>
      </p>
      <a
        href="/about"
        class="inline-block px-6 py-3 border border-slate-700 rounded-lg hover:bg-slate-800 hover:text-violet-400 transition-colors"
        transition:animate={fade({ duration: "0.5s" })}
      >
        About Me →
      </a>
    </div>
    <a
      href="/icon"
      class="flex-shrink-0 w-48 h-48 md:w-64 md:h-64 lg:w-72 lg:h-72 text-slate-300 [&_svg]:w-full [&_svg]:h-full [&_path]:fill-current hover:text-slate-100 hover:scale-105 hover:-translate-y-2 hover:drop-shadow-[0_20px_40px_rgba(255,255,255,0.25)] transition-all duration-300"
      transition:name="profile-icon"
      aria-label={`${profile.name}のプロフィールアイコン`}
    >
      <Fragment set:html={profileSvg} />
    </a>
  </div>
</section>

<style is:global>
  /* タイピングアニメーション */
  .typing {
    display: inline-block;
    overflow: hidden;
    white-space: nowrap;
    border-right: 2px solid currentColor;
    animation:
      typing 2s steps(11) 0.5s forwards,
      blink 0.7s step-end infinite;
    width: 0;
  }

  @keyframes typing {
    to {
      width: 12ch;
    }
  }

  @keyframes blink {
    50% {
      border-color: transparent;
    }
  }

  /* パーティクル背景 */
  .particles {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  .particle {
    position: absolute;
    width: 4px;
    height: 4px;
    background: color-mix(in srgb, var(--color-violet-400) 40%, transparent);
    border-radius: 50%;
    animation: float 15s infinite ease-in-out;
    left: calc(var(--i) * 5%);
    top: calc(var(--i) * 5%);
    animation-delay: calc(var(--i) * -0.75s);
  }

  .particle:nth-child(odd) {
    width: 2px;
    height: 2px;
    background: color-mix(in srgb, var(--color-violet-400) 25%, transparent);
  }

  .particle:nth-child(3n) {
    background: color-mix(in srgb, var(--color-violet-400) 60%, transparent);
    width: 5px;
    height: 5px;
  }

  @keyframes float {
    0%,
    100% {
      transform: translate(0, 0) scale(1);
      opacity: 0.4;
    }
    25% {
      transform: translate(80px, -50px) scale(1.3);
      opacity: 0.8;
    }
    50% {
      transform: translate(30px, 60px) scale(0.7);
      opacity: 0.5;
    }
    75% {
      transform: translate(-50px, 30px) scale(1.2);
      opacity: 0.7;
    }
  }
</style>

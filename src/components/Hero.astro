---
import { Image } from "astro:assets";
import profileImage from "@/assets/images/profile.png";

const profile = {
  name: "Ryo Ohshima",
  title: "WEB DEVELOPER",
};
---

<section aria-label="ヒーローセクション" class="min-h-screen flex items-center">
  <div class="w-full max-w-6xl mx-auto p-4 flex items-center justify-between">
    <div class="flex-1 text-center md:text-left">
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-4">
        {profile.name}
      </h1>
      <p class="text-lg md:text-xl tracking-widest">
        {profile.title}
      </p>
    </div>
    <div class="flex-shrink-0">
      <Image
        src={profileImage}
        alt={`${profile.name}のプロフィール画像`}
        width={280}
        height={280}
        class="w-48 h-48 md:w-64 md:h-64 lg:w-72 lg:h-72 rounded-2xl object-cover"
      />
    </div>
  </div>
</section>

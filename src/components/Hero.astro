---
import { fade, slide } from "astro:transitions";
import profileSvg from "@/assets/images/profile_white.svg?raw";

const profile = {
  name: "Ryo Ohshima",
  title: "WEB DEVELOPER",
};
---

<section
  aria-label="ヒーローセクション"
  class="min-h-screen flex items-center"
  transition:animate={fade({ duration: "0.3s" })}
>
  <div class="w-full max-w-6xl mx-auto p-4 flex items-center justify-between">
    <div class="flex-1 text-center md:text-left">
      <h1
        class="text-4xl md:text-5xl lg:text-6xl font-bold mb-4"
        transition:animate={slide({ duration: "0.5s" })}
      >
        {profile.name}
      </h1>
      <p
        class="text-lg md:text-xl tracking-widest mb-8"
        transition:animate={slide({ duration: "0.4s" })}
      >
        {profile.title}
      </p>
      <a
        href="/about"
        class="inline-block px-6 py-3 border border-slate-700 rounded-lg hover:bg-slate-800 hover:text-violet-400 transition-colors"
        transition:animate={fade({ duration: "0.5s" })}
      >
        About Me →
      </a>
    </div>
    <a
      href="/icon"
      class="flex-shrink-0 w-48 h-48 md:w-64 md:h-64 lg:w-72 lg:h-72 text-slate-300 [&_svg]:w-full [&_svg]:h-full [&_path]:fill-current hover:text-slate-100 hover:scale-105 hover:-translate-y-2 hover:drop-shadow-[0_20px_40px_rgba(255,255,255,0.25)] transition-all duration-300"
      transition:name="profile-icon"
      aria-label={`${profile.name}のプロフィールアイコン`}
    >
      <Fragment set:html={profileSvg} />
    </a>
  </div>
</section>

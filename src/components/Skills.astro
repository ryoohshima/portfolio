---
import { Icon } from "astro-icon/components";
import { fade, slide } from "astro:transitions";

interface Skill {
  name: string;
  icon: string;
  color: string;
}

const skills: Skill[] = [
  { name: "TypeScript", icon: "simple-icons:typescript", color: "#3178C6" },
  { name: "React", icon: "simple-icons:react", color: "#61DAFB" },
  { name: "Next.js", icon: "simple-icons:nextdotjs", color: "#FFFFFF" },
  { name: "Astro", icon: "simple-icons:astro", color: "#FF5D01" },
  { name: "Node.js", icon: "simple-icons:nodedotjs", color: "#339933" },
  { name: "Tailwind CSS", icon: "simple-icons:tailwindcss", color: "#06B6D4" },
  { name: "PostgreSQL", icon: "simple-icons:postgresql", color: "#4169E1" },
  { name: "Git", icon: "simple-icons:git", color: "#F05032" },
];
---

<section
  id="skills"
  aria-labelledby="skills-title"
  class="py-20"
  transition:animate={fade({ duration: "0.3s" })}
>
  <div class="max-w-6xl mx-auto px-4">
    <h2
      id="skills-title"
      class="text-3xl font-bold mb-12 text-center"
      transition:animate={slide({ duration: "0.4s" })}
    >
      SKILLS
      <span class="block w-12 h-1 bg-amber-400 mx-auto mt-4 rounded-full"></span>
    </h2>
    <ul class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-6">
      {
        skills.map((skill, index) => (
          <li
            class="skill-item group flex flex-col items-center gap-3 p-6 rounded-2xl bg-slate-900 hover:bg-slate-800 hover:ring-2 hover:ring-slate-700 hover:scale-105 transition-[transform,background-color,box-shadow] duration-300"
            style={`--brand-color: ${skill.color}`}
            transition:animate={fade({ duration: `${0.3 + index * 0.05}s` })}
          >
            <span class="inline-block transition-transform duration-300 group-hover:scale-110 group-hover:rotate-6">
              <Icon
                name={skill.icon}
                class="w-12 h-12 transition-colors duration-300 group-hover:[color:var(--brand-color)]"
              />
            </span>
            <span class="text-sm font-medium">{skill.name}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>


---
import { Icon } from "astro-icon/components";
import { fade, slide } from "astro:transitions";

interface Skill {
  name: string;
  icon: string;
}

const skills: Skill[] = [
  { name: "TypeScript", icon: "simple-icons:typescript" },
  { name: "React", icon: "simple-icons:react" },
  { name: "Next.js", icon: "simple-icons:nextdotjs" },
  { name: "Astro", icon: "simple-icons:astro" },
  { name: "Node.js", icon: "simple-icons:nodedotjs" },
  { name: "Tailwind CSS", icon: "simple-icons:tailwindcss" },
  { name: "PostgreSQL", icon: "simple-icons:postgresql" },
  { name: "Git", icon: "simple-icons:git" },
];
---

<section
  id="skills"
  aria-labelledby="skills-title"
  class="py-20"
  transition:animate={fade({ duration: "0.3s" })}
>
  <div class="max-w-6xl mx-auto px-4">
    <h2
      id="skills-title"
      class="text-3xl font-bold mb-12 text-center"
      transition:animate={slide({ duration: "0.4s" })}
    >
      SKILLS
    </h2>
    <ul class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-6">
      {
        skills.map((skill, index) => (
          <li
            class="group flex flex-col items-center gap-3 p-6 rounded-2xl bg-slate-900 hover:bg-slate-800 hover:ring-2 hover:ring-slate-700 hover:scale-105 transition-[transform,background-color,box-shadow] duration-300"
            transition:animate={fade({ duration: `${0.3 + index * 0.05}s` })}
          >
            <Icon
              name={skill.icon}
              class="w-12 h-12 group-hover:scale-110 group-hover:rotate-6 transition-transform duration-300"
            />
            <span class="text-sm font-medium">{skill.name}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
